# Existing Avatar Neon identity. No database connection string is required here.
NEON_AUTH_BASE_URL=https://ep-cool-scene-bcic0kwx.neonauth.c-16.us-east-1.aws.neon.tech/neondb/auth
# Exact reviewed HTTPS preview origin. Add that same origin to Neon trusted domains.
AVATAR_APP_ORIGIN=

# Keep disabled until an explicit identity mapping and Core's key trust grant pass review.
CORE_CHAT_ENABLED=false
CORE_API_BASE_URL=https://core-api-staging-dec8a723.up.railway.app
CORE_AUTH_ISSUER=
CORE_AUTH_AUDIENCE=
CORE_AUTH_CLIENT_ID=
CORE_AUTH_KEY_ID=
CORE_AUTH_PRIVATE_KEY=
CORE_IDENTITY_BINDINGS_JSON=

# Gateway speech requires a scoped Core voice grant and the Avatar settings DB issuance table.
# Prefer Vercel OIDC in the deployed environment. Local canaries use a short-lived Gateway key.
AVATAR_GATEWAY_LIVE_ENABLED=false
AI_GATEWAY_API_KEY=

# Render-only Tavus video uses Eden's verified face and a separate finite owner grant.
AVATAR_TAVUS_RENDER_ENABLED=false
AVATAR_TAVUS_RENDER_SCOPE_ID=
AVATAR_TAVUS_RENDER_GRANT_EXPIRES_AT=
TAVUS_API_KEY=

# Never use a static owner bearer or a browser-visible provider/signing key.
